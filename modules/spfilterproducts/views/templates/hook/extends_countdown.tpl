<div class="product-countdown" data-time="{$specialPriceToDate}" 
	data-number_day="{l s=' Day' mod='spfilterproducts'}"
	data-number_days="{l s=' Days' mod='spfilterproducts'}"
	data-number_hour="{l s=' Hour' mod='spfilterproducts'}"
	data-number_hours="{l s=' Hours' mod='spfilterproducts'}"
	data-number_minute="{l s=' Min' mod='spfilterproducts'}"
	data-number_minutes="{l s=' Mins' mod='spfilterproducts'}"
	data-number_secon="{l s=' Sec' mod='spfilterproducts'}"
	data-number_secons="{l s=' Secs' mod='spfilterproducts'}">
	<span class="clock-time"></span>
</div>